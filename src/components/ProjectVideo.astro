---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../translation';

interface Props {
  video: NonNullable<CollectionEntry<'projects'>['data']['video']>;
  locale: Locale;
}

const { video, locale } = Astro.props;
---

<figure class="project-media project-video">
  <video
    controls
    playsinline
    preload="none"
    poster={video.poster}
    width={video.width}
    height={video.height}
    aria-label={video.caption}
    aria-describedby="intro-video-description"
  >
    <source src={video.src} type="video/mp4" />
    <a href={video.src}>{locale === 'de' ? 'Video als MP4 öffnen' : 'Open video as MP4'}</a>
  </video>
  <figcaption>
    <strong>{video.caption}</strong>
    <p id="intro-video-description">{video.description}</p>
  </figcaption>
</figure>
