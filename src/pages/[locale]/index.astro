---
import Layout from '../../layouts/Layout.astro';
import { PROJECTS, type Project} from '../../data/projects' 
import { EXPERIENCES } from '../../data/experiences'
import { createLocalizer, type Locale } from '../../translation';
import { uiText } from '../../data/ui-text';

export function getStaticPaths() {
  return [
    { params: { locale: "de" } },
    { params: { locale: "en" } },
  ];
}

const locale = Astro.params.locale as Locale

const t = createLocalizer(locale)
---

<Layout {locale}>
	<main>
		<section id="hero">
			<article id="about">
				<header class="section-header">
					<p class="eyebrow">01 / {t(uiText.hero.aboutMe)}</p>
					<h1 id="author">Enrico Perea</h1>
				</header>
				<h2>{t(uiText.hero.headline)}</h2>
				<p>{t(uiText.hero.intro)}</p>
			</article>
			<article id="about-meta">
				<table>
					<tr>
						<td>{t(uiText.hero.metadata.focus)}</td>
						<td>UX</td>
					</tr>
					<tr>
						<td>{t(uiText.hero.metadata.projects)}</td>
						<td><a class="no-underline" href="https://github.com/enricoprma" target="_blank" rel="noreferrer">GitHub↗</a></td>
					</tr>
					<tr>
						<td>{t(uiText.hero.metadata.contact)}</td>
						<td><a class="no-underline" href="mailto:enrico.perea@yahoo.de" target="_blank" rel="noreferrer">{t(uiText.hero.metadata.email)}</a></td>
					</tr>
				</table>
			</article>
		</section>

		<hr/>

		<section id="projects-section">
			<header class="section-header">
				<p class="eyebrow">02 / {t(uiText.projects.label)}</p>
				<h1>{t(uiText.projects.heading)}</h1>
			</header>
			<div id="projects">
				{PROJECTS && PROJECTS.map((project: Project, i) => (
					<div class="project">
						<header class="section-header">
							<p class="eyebrow">{t(uiText.projects.itemLabel)} {(i+1).toLocaleString(undefined, {minimumIntegerDigits: 2})}</p>
							<h2>{project.title}</h2>
						</header>
						<div class="project-content">
							<p>{t(project.description)}</p>
							<div class="tags">
								{project.tags.map(tag => (
									<h6 class="tag">{typeof tag === 'string' ? tag : t(tag)}</h6>
								))}
							</div>
						</div>
						<footer class="project-footer">
							<hr class="soft"/>
							<div class="links">
								{project.links && project.links.map(link => (
									<small><a class="link" href={link.href} target="_blank" rel="noreferrer">{typeof link.label === 'string' ? link.label : t(link.label)}</a></small>
								))}
							</div>
						</footer>
					</div>
				))}
			</div>
		</section>

		<hr/>

		<section id="experiences-section">
			<header class="section-header">
				<p class="eyebrow">03 / {t(uiText.experience.label)}</p>
				<h1>{t(uiText.experience.heading)}</h1>
			</header>
			<div id="experiences">
				{EXPERIENCES && EXPERIENCES.map(experience => (
					<>
						<hr/>
						<div class="experience">
							<h4>{experience.startDate} - {experience.endDate}</h4>
							<div>
								<h2>{experience.company}</h2>
								<h4 style="color: var(--coral-deep)">{t(experience.role)}</h4>
								<ul>
									{experience.description.map(d => (
										<li>{t(d)}</li>
									))}
								</ul>
								<div class="tags">
									{experience.technologies.map(t => (
										<h6 class="tag">{t}</h6>
									))}
								</div>
							</div>
							<div></div>
						</div>
					</>
				))}
			</div>
		</section>
	</main>
</Layout>
<style>

	main {
		padding: var(--space-6);
		border: 1px dashed;
	}

	.section-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	#hero {
		display: flex;
		justify-content: space-between;
		align-items: end;
	}

	#about {
		width: 50%;
	}

	#about-meta table tr td:nth-child(2) {
		text-align: end;
	}

	td:first-child {
		padding-left: var(--space-1);
		padding-right: var(--space-2);
	}

	td:nth-child(2) {
		padding-left: var(--space-2);
		padding-right: var(--space-1);
	}

	#projects-section, #experiences-section {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.project, .experience{
		padding: var(--space-1);
	}

	#projects {
		display: flex;
		gap: var(--space-6);
		align-items: stretch;
	}
	.project {
		display: flex;
		flex-direction: column;
		width: 50%;
		padding: var(--space-5);
		border: 2px dashed;
		gap: var(--space-2);
	}
	.project-content {
		display: flex;
		gap: var(--space-5);
		align-items: flex-start;
	}
	.project-content > * {
		width: 50%;
	}
	.links{
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--space-2);
	}
	.project-footer {
		margin-top: auto;
	}


	#experiences {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.experience {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
	}

	.tags, .links {
		display: flex;
		flex-wrap: wrap;
	}
	.tags {
		column-gap: var(--space-2);
	}

	@media (max-width: 820px) {

		main {
			padding: var(--space-4);
		}

		#hero {
			flex-direction: column;
			align-items: start;
			gap: var(--space-2);
		}

		#about {
			width: 100%;
		}

		#projects {
			flex-direction: column;
			gap: var(--space-3)
		}
		.project {
			width: 100%;
		}
		.project-content {
			flex-direction: column;
			gap: var(--space-1);
		}
		.project-content > * {
			width: 100%;
		}

		#experiences-section h1 {
			margin-bottom: 0;
		}

		#experiences {
			gap: 0;
		}

		.experience {
			grid-template-columns: none;
			gap: var(--space-2);
		}

		.tags {
			column-gap: var(--space-1);
		}
		.tag {
			margin-bottom: var(--space-1);
		}

	}
</style>
