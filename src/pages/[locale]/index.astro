---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ExperienceItem from '../../components/ExperienceItem.astro';
import { PROJECTS } from '../../data/projects';
import { EXPERIENCES } from '../../data/experiences';
import { createLocalizer, type Locale } from '../../translation';
import { uiText } from '../../data/ui-text';

export function getStaticPaths() {
  return [
    { params: { locale: "de" } },
    { params: { locale: "en" } },
  ];
}

const locale = Astro.params.locale as Locale;

const t = createLocalizer(locale);
---

<Layout {locale}>
	<main>
		<section id="hero">
			<article id="about">
				<header class="section-header">
					<p class="eyebrow">01 / {t(uiText.hero.aboutMe)}</p>
					<h1 id="author">Enrico Perea</h1>
				</header>
				<h2>{t(uiText.hero.headline)}</h2>
				<p>{t(uiText.hero.intro)}</p>
			</article>
			<article id="about-meta">
				<img class="hero-illustration" src="/illustrations/hero-ux-code.svg" alt="">
				<table>
					<tr>
						<td class="metadata-label">{t(uiText.hero.metadata.focus)}</td>
						<td class="metadata-value">UX</td>
					</tr>
					<tr>
						<td class="metadata-label">{t(uiText.hero.metadata.projects)}</td>
						<td class="metadata-value"><a class="no-underline" href="https://github.com/enricoprma" target="_blank" rel="noreferrer">GitHub↗</a></td>
					</tr>
					<tr>
						<td class="metadata-label">{t(uiText.hero.metadata.contact)}</td>
						<td class="metadata-value"><a class="no-underline" href="mailto:enrico.perea@yahoo.de" target="_blank" rel="noreferrer">{t(uiText.hero.metadata.email)}</a></td>
					</tr>
				</table>
			</article>
		</section>

		<hr/>

		<section id="projects-section" class="portfolio-section">
			<header class="section-header">
				<p class="eyebrow">02 / {t(uiText.projects.label)}</p>
				<h1>{t(uiText.projects.heading)}</h1>
			</header>
			<div id="projects">
				{PROJECTS.map((project, index) => (
					<ProjectCard {project} {index} {locale} />
				))}
			</div>
		</section>

		<hr/>

		<section id="experiences-section" class="portfolio-section">
			<header class="section-header">
				<p class="eyebrow">03 / {t(uiText.experience.label)}</p>
				<h1 class="experience-heading">{t(uiText.experience.heading)}</h1>
			</header>
			<div id="experiences">
				{EXPERIENCES.map(experience => (
					<ExperienceItem {experience} {locale} />
				))}
			</div>
		</section>
	</main>
</Layout>
<style>
  main {
    padding: var(--space-6);
    border: 1px dashed;
  }

  #hero {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-5);
  }

  #about {
    width: 50%;
    display: flex;
    flex-direction: column;
  }

  #about-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hero-illustration {
    width: 100%;
  }

  .metadata-label {
    padding-left: var(--space-1);
    padding-right: var(--space-2);
  }

  .metadata-value {
    padding-left: var(--space-2);
    padding-right: var(--space-1);
    text-align: end;
  }

  .portfolio-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  #projects {
    display: flex;
    gap: var(--space-6);
    align-items: stretch;
  }

  #experiences {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 1360px) {
    #hero {
      flex-direction: column;
    }

    #about {
      width: 100%;
    }
  }

  @media (max-width: 820px) {
    main {
      padding: var(--space-4);
    }

    #projects {
      flex-direction: column;
      gap: var(--space-3);
    }

    .experience-heading {
      margin-bottom: 0;
    }
  }
</style>
